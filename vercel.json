{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/api/main.py"
    }
  ],
  "env": {
    "PYTHONPATH": "backend",
    "CONFIDENCE_THRESHOLD": "0.75",
    "FAIL_ON_DRIFT": "true",
    "OLLAMA_URL": "http://localhost:11434",
    "MODEL_NAME": "gemma4:e4b"
  }
}
